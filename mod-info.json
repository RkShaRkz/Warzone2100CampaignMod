{
  "name": "Sharkmod",
  "version": "0.0.1",
  "author": "Shark",
  "type": "campaignBalanceMod",
  "license": "GPL-2.0-or-later",
  "minVersionSupported": "4.5.2",
  "maxVersionTested": "4.6.1",
  "description": {
     "en": "Sharkmod just adds a few things to the vanilla campaign, and that's it"
  },
  "updatesUrl": "https://github.com/DARwins1/fractured-kingdom/releases/latest",
  "campaigns": [
    "fracturedkingdom.json"
  ],
  "universe": "unique",
  "difficultyLevels": "default",
  "camTweakOptions": [
    {
      "id": "timerPowerBonus",
      "default": true,
      "userEditable": true
    },
    {
      "id": "classicTimers",
      "default": false,
      "userEditable": true
    },
    {
      "id": "playerUnitCap40",
      "default": false,
      "userEditable": true
    },
    {
      "id": "autosavesOnly",
      "default": false,
      "userEditable": true
    }
  ],
  "customTweakOptions": [
    {
      "id": "fk_dayCycle",
      "type": "bool",
      "default": true,
      "displayName": {
        "en": "Day/Night Cycle"
      },
      "description": {
        "en": "Enables a visual day-to-night sun cycle. The day/night cycle can also be toggled in-game with the \"toggle dn\" chat command."
      }
    },
    {
      "id": "fk_allyVision",
      "type": "bool",
      "default": true,
      "displayName": {
        "en": "Ally Vision"
      },
      "description": {
        "en": "Enables constant visibility of all allied units/structures. May cause performance impacts. Can be toggled in-game with the \"toggle vision\" chat command."
      }
    }
  ]
}
